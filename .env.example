# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Never expose a service-role key to the browser; this MVP does not need one.

# Sumsub (ID check for creators) — server-side only, set in Vercel, never commit values
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=
# Used ONLY by the Sumsub webhook route (server). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
